@{
    ViewData["Title"] = "Chess Board";
}
<link rel="stylesheet" href="~/css/chessboard.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="captured-panel" id="captured-top"></div>

<div class="game-layout">

    <!-- Clocks -->
    <div class="clocks">
        <div id="opponent-clock" class="clock">05:00</div>
        <div id="player-clock" class="clock">05:00</div>
    </div>

    <!-- Chessboard -->
    <div class="chess-container" id="chessboard">
        @for (int row = 0; row < 8; row++)
        {
            @for (int col = 0; col < 8; col++)
            {
                var isDark = (row + col) % 2 == 1;
                <div class="square @(isDark ? "dark" : "light")"
                     data-x="@col" data-y="@row"></div>
            }
        }
    </div>


</div>

<div id="promotion-overlay" class="promotion-overlay hidden">
    <div id="promotion-button-container" class="promotion-buttons"></div>
</div>

<div class="captured-panel" id="captured-bottom"></div>

<div id="game-over-overlay" class="game-over hidden">
    <div class="game-over-box">
        <h2 id="game-over-text"></h2>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="~/js/clock.js"></script>
<script src="~/js/chess.js"></script>
